{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "florambiente",
  "main": "worker.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "REVIEWS_DB",
      "database_name": "flora-recensioni",
      "database_id": "898790e3-eaf2-4e11-89da-73ce8811406d"
    }
  ]
}
